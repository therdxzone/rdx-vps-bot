# Discord Bot Token (from Discord Developer Portal)
TOKEN=your_discord_bot_token_here

# Admin Discord User ID (get from Discord Developer Mode)
ADMIN_ID=123456789012345678

# Bot Configuration
BOT_STATUS_NAME=RDX
WATERMARK=Powered by RDX

# VPS Defaults
DEFAULT_RAM=2g
DEFAULT_CPU=1
DEFAULT_DISK=10G
VPS_HOSTNAME=rdx-free
SERVER_LIMIT=1
TOTAL_SERVER_LIMIT=50

# Database
DATABASE_FILE=vps_bot.db

# Bot version shown in embed footers (e.g. "QuantaForge • v1.0.0 • RDX")
BOT_VERSION=1.0.0